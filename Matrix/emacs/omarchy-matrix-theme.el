   ;; --- Mode line / header / tabs ------------------------------------
   `(mode-line
     ((,class :background ,select :foreground ,accent :weight bold
              :box (:line-width 1 :color ,accent))))
   `(mode-line-active ((,class :inherit mode-line)))
   `(mode-line-inactive
     ((,class :background ,bg-darker :foreground ,fg-dark
              :box (:line-width 1 :color ,muted))))
   `(mode-line-highlight ((,class :foreground ,fg-bright :background ,muted)))
   `(mode-line-buffer-id ((,class :foreground ,accent :weight bold)))
   `(mode-line-emphasis ((,class :foreground ,fg-bright :weight bold)))
   `(header-line
     ((,class :background ,bg-dark :foreground ,fg-light
              :box (:line-width 1 :color ,muted))))
   `(tab-bar ((,class :background ,bg-dark :foreground ,fg-dark)))
   `(tab-bar-tab
     ((,class :background ,bg :foreground ,accent :weight bold
              :box (:line-width 1 :color ,accent))))
   `(tab-bar-tab-inactive ((,class :background ,bg-darker :foreground ,fg-dark)))
   `(tab-line ((,class :background ,bg-darker :foreground ,fg-dark)))
   `(tab-line-tab-current ((,class :background ,bg :foreground ,accent :weight bold)))
   `(tab-line-tab-inactive ((,class :background ,bg-darker :foreground ,fg-dark)))
   `(tab-line-highlight ((,class :background ,select :foreground ,fg-bright)))

   ;; --- Line numbers / fill / paren ----------------------------------
