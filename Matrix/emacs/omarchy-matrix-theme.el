;;; omarchy-matrix-theme.el --- CRT phosphor theme matching Omarchy Matrix -*- lexical-binding: t; -*-

;; Author: Justin Andrusk
;; Version: 1.0
;; Package-Requires: ((emacs "29.1"))
;; Keywords: faces, theme

;;; Commentary:
;;
;; Dark digital-rain theme whose palette is taken from the Omarchy
;; Matrix desktop theme (~/.config/omarchy/themes/matrix/colors.toml).
;; Syntax roles follow the generated Helix / VS Code mappings so Emacs
;; matches the rest of the desktop.

;;; Code:

(deftheme omarchy-matrix
  "Dark CRT phosphor theme matching the Omarchy Matrix desktop."
  :background-mode 'dark
  :kind 'color-scheme)

(let* ((class '((class color) (min-colors 89)))
       ;; Core (colors.toml)
       (bg        "#050a05")
       (bg-dark   "#030603")
       (bg-darker "#010201")
       (bg-alt    "#0d160d")
       (fg        "#9ae89a")
       (fg-dark   "#3d7a48")
       (fg-light  "#c4f5c4")
       (fg-bright "#e8ffe8")
       (accent    "#00ff41")
       (select    "#0a3d14")
       (muted     "#1f5c28")
       ;; ANSI / semantic
       (red       "#e20400")
       (yellow    "#c6e547")
       (orange    "#e36a13")
       (green     "#00d632")
       (cyan      "#33ff88")
       (blue      "#3a74d2")
       (magenta   "#6b37b3")
       (brown     "#3d6b2f")
       (bred      "#ff4a45")
       (byellow   "#e8ff6a")
       (bgreen    "#5cff7a")
       (bcyan     "#7dffb0")
       (bblue     "#6a9eff")
       (bmagenta  "#9a6adf")
       ;; Derived (still in-family; used where the raw hue is too dim)
       (comment   "#3d7a48")
       (keyword   "#9a6adf")
       (fn        "#6a9eff")
       (type      "#c6e547")
       (str       "#00d632")
       (const     "#e36a13")
       (builtin   "#33ff88")
       (cursor-c  "#00ff41"))
  (custom-theme-set-faces
   'omarchy-matrix

   ;; --- Core ----------------------------------------------------------
   `(default ((,class :background ,bg :foreground ,fg)))
   `(cursor ((,class :background ,cursor-c :foreground ,bg)))
   `(fringe ((,class :background ,bg :foreground ,muted)))
   `(vertical-border ((,class :foreground ,muted)))
   `(window-divider ((,class :foreground ,muted)))
   `(window-divider-first-pixel ((,class :foreground ,muted)))
   `(window-divider-last-pixel ((,class :foreground ,muted)))
   `(internal-border ((,class :foreground ,muted)))
   `(scroll-bar ((,class :background ,bg :foreground ,muted)))
   `(border ((,class :foreground ,muted)))
   `(shadow ((,class :foreground ,fg-dark)))
   `(link ((,class :foreground ,blue :underline t)))
   `(link-visited ((,class :foreground ,bmagenta :underline t)))
   `(button ((,class :foreground ,accent :underline t)))
   `(highlight ((,class :background ,select :foreground ,fg-bright)))
   `(hl-line ((,class :background ,bg-alt :extend t)))
   `(region ((,class :background ,select :foreground ,fg-bright :extend t)))
   `(secondary-selection ((,class :background ,muted :foreground ,fg-bright :extend t)))
   `(trailing-whitespace ((,class :background ,red)))
   `(escape-glyph ((,class :foreground ,cyan)))
   `(nobreak-space ((,class :foreground ,cyan :underline t)))
   `(homoglyph ((,class :foreground ,yellow)))
