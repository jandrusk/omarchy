   `(show-paren-mismatch ((,class :background ,red :foreground ,fg-bright :weight bold)))
   `(sp-show-pair-match-face ((,class :inherit show-paren-match)))
   `(sp-show-pair-mismatch-face ((,class :inherit show-paren-mismatch)))

